# ==============================================================================
# PayRecover AI — Environment Configuration
# ==============================================================================
# Copy this file to .env.local and fill in actual values.
# NEVER commit .env.local or any file containing real secrets.
# ==============================================================================

# --- Server ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/payrecover

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Razorpay (Test Mode ONLY) ---
# Obtain from https://dashboard.razorpay.com/app/keys (Test Mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RUN_RAZORPAY_TESTMODE=true

# --- NVIDIA AI (Nemotron via Build API) ---
# Obtain from https://build.nvidia.com/
NVIDIA_API_KEY=
NVIDIA_MODEL_ID=nvidia/nemotron-3-ultra-550b-a55b

# --- Authentication (Demo-grade shared secret) ---
MERCHANT_API_KEY=
VITE_MERCHANT_API_KEY=

# --- PII Protection ---
# Used for HMAC-SHA256 pseudonymization of customer data
PII_HMAC_SECRET=
