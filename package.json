{
  "name": "payrecover-ai",
  "version": "0.1.0",
  "private": true,
  "description": "AI-assisted revenue recovery for failed payments — Razorpay AI Buildathon Track 3",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "type-check": "turbo run type-check",
    "evaluate": "tsx evaluation/runner.ts",
    "db:migrate": "tsx database/cli.ts latest",
    "db:rollback": "tsx database/cli.ts rollback",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "rimraf": "^6.0.0",
    "turbo": "^2.1.0",
    "typescript": "^5.6.0"
  },
  "packageManager": "npm@10.8.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
